{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Bash on Windows Attach",
            "type": "cppdbg",
            "request": "attach",
            "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
            "processId": "${command:pickRemoteProcess}",
            "pipeTransport": {
                "debuggerPath": "/usr/bin/gdb",
                "pipeProgram": "${env:windir}\\system32\\bash.exe",
                "pipeArgs": ["-c"],
                "pipeCwd": ""
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },

        {
            "name": "(windows) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "D:\\C++ Code\\Binary Tree\\a.exe"
, // The compiled program
            "args": [], // Pass command-line arguments here
            "stopAtEntry": false,
           "cwd": "D:\\C++ Code\\Binary Tree"
,
            "environment": [],
            "externalConsole": false, // If true, it opens a new terminal for debugging
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build", // Runs the 'build' task before debugging
           "miDebuggerPath": "C:\\MinGW\\bin\\gdb.exe"
 // Adjust for your system
        }

    ],
}